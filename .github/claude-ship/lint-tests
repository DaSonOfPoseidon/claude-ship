# Cases for the rules of .github/claude-ship/lint, run by `hooks/lint.sh check` (and by tests/lint.sh, so CI enforces
# them). One case per line: `hit|miss <rule> <path> <text>`, the text being the rest of the line, literal. A `hit`
# case passes when the rule reports on that one added line, a `miss` case when it doesn't. The path decides which globs
# and which comment syntax apply, so it need not exist. Format and the rest: hooks/lint-rules.

# gnu-sed-i: sed -i, in its cluster, attached, long and after another option; not a comment, not the tests, not another
# option's argument.
hit gnu-sed-i hooks/x.sh sed -i 's/a/b/' "$f"
hit gnu-sed-i hooks/x.sh sed -e p -i "$f"
hit gnu-sed-i scripts/x.sh sed -ni '1p' "$f"
hit gnu-sed-i hooks/x.sh sed --in-place s/a/b/ f
miss gnu-sed-i tests/x.sh sed -i 's/a/b/' "$f"
miss gnu-sed-i hooks/x.sh # sed -i is GNU-only
miss gnu-sed-i hooks/x.sh sed -E 's/a/b/' "$f"
miss gnu-sed-i hooks/x.sh sed -e -i f

# gnu-date-d: date -d, attached or not, and the long form; date -u alone and a comment are fine.
hit gnu-date-d hooks/x.sh x=$(date -u -d @0 +%s)
hit gnu-date-d hooks/x.sh date -d2026-11-19 +%s
hit gnu-date-d scripts/x.sh date --date=@0 +%s
miss gnu-date-d tests/x.sh date -d @0 +%s
miss gnu-date-d hooks/x.sh # date -d is GNU-only
miss gnu-date-d hooks/x.sh date -u +%s
miss gnu-date-d hooks/x.sh date -- -d

# gnu-grep-p: grep -P, alone, in a cluster and long; an option's argument and the tests are not.
hit gnu-grep-p hooks/x.sh grep -oP 'a+' "$f"
hit gnu-grep-p hooks/x.sh grep --perl-regexp a f
hit gnu-grep-p scripts/x.sh grep --regexp foo -nP "$f"
miss gnu-grep-p tests/x.sh grep -P a f
miss gnu-grep-p hooks/x.sh # grep -P is GNU-only
miss gnu-grep-p hooks/x.sh grep -e -P f
miss gnu-grep-p hooks/x.sh grep -f -P f
miss gnu-grep-p hooks/x.sh grep -- -P f

# gnu-readlink-f: readlink -f, in a cluster and as --canonicalize.
hit gnu-readlink-f hooks/x.sh readlink -f "$0"
hit gnu-readlink-f hooks/x.sh readlink -fn "$0"
hit gnu-readlink-f scripts/x.sh readlink --canonicalize "$0"
miss gnu-readlink-f tests/x.sh readlink -f "$0"
miss gnu-readlink-f hooks/x.sh # readlink -f is GNU-only
miss gnu-readlink-f hooks/x.sh readlink "$0"

# gnu-stat-c: stat -c and --format.
hit gnu-stat-c hooks/x.sh stat -c %s "$f"
hit gnu-stat-c hooks/x.sh stat --format=%s "$f"
hit gnu-stat-c scripts/x.sh stat -Lc %s "$f"
miss gnu-stat-c tests/x.sh stat -c %s "$f"
miss gnu-stat-c hooks/x.sh # stat -c is GNU-only
miss gnu-stat-c hooks/x.sh wc -c < "$f"

# pitfall-pipeline-status: a gh call piped inside $( ), assigned or not; a quoted pipe, a fallback, a quoted mention and a comment are not.
hit pitfall-pipeline-status hooks/x.sh x=$(gh api repos/o/r/pulls | wc -l)
hit pitfall-pipeline-status scripts/x.sh n=$(gh -R o/r api pulls/1/reviews | jq length)
miss pitfall-pipeline-status tests/x.sh x=$(gh api repos/o/r/pulls | wc -l)
miss pitfall-pipeline-status hooks/x.sh # x=$(gh api repos/o/r/pulls | wc -l)
miss pitfall-pipeline-status hooks/x.sh x=$(gh api --jq '.[] | .id' repos/o/r/pulls)
miss pitfall-pipeline-status hooks/x.sh x=$(gh api repos/o/r/pulls || echo 0)
miss pitfall-pipeline-status hooks/x.sh echo "x=$(gh api repos/o/r | wc -l)"

# pitfall-missing-arg-exit: a positional-argument guard that exits 1 on the same line; exit 2, a test of another value, and tests/ are not.
hit pitfall-missing-arg-exit hooks/x.sh [ -z "$1" ] && exit 1
hit pitfall-missing-arg-exit scripts/x.sh if [ "$#" -lt 2 ]; then echo usage >&2; exit 1; fi
miss pitfall-missing-arg-exit tests/x.sh [ -z "$1" ] && exit 1
miss pitfall-missing-arg-exit hooks/x.sh [ -z "$1" ] && exit 2
miss pitfall-missing-arg-exit hooks/x.sh [ -f "$f" ] || exit 1
miss pitfall-missing-arg-exit hooks/x.sh # [ -z "$1" ] && exit 1

# pitfall-status-stale: cancel-in-progress true in a codex workflow, quoted or not; false, a comment and other workflows are not.
hit pitfall-status-stale .github/workflows/codex-status.yml cancel-in-progress: true
hit pitfall-status-stale .github/workflows/codex-review.yml cancel-in-progress: "true"
miss pitfall-status-stale .github/workflows/codex-status.yml cancel-in-progress: false
miss pitfall-status-stale .github/workflows/codex-status.yml # cancel-in-progress: true
miss pitfall-status-stale .github/workflows/ci.yml cancel-in-progress: true

# pitfall-current-checkout: gh pr with a subcommand that acts on a PR and no number before its flags or end; a pipe after
# a space counts, a quoted mention, a numbered or placeholder call, a comment, and tests/ are not.
hit pitfall-current-checkout hooks/x.sh gh pr checks --watch
hit pitfall-current-checkout scripts/x.sh gh pr merge --squash --delete-branch
hit pitfall-current-checkout hooks/x.sh gh pr view | jq .title
miss pitfall-current-checkout tests/x.sh gh pr checks --watch
miss pitfall-current-checkout hooks/x.sh gh pr checks "$pr" --watch
miss pitfall-current-checkout hooks/x.sh gh pr view 12 --json headRefOid
miss pitfall-current-checkout hooks/x.sh # gh pr checks --watch
miss pitfall-current-checkout hooks/x.sh echo "run gh pr view --web"

# pitfall-filter-by-branch-name: gh pr list filtered by --head or -H with no isCrossRepository on the line; a comment, a
# quoted mention, a line that asks for isCrossRepository, and tests/ are not.
hit pitfall-filter-by-branch-name hooks/x.sh milestone=$(gh pr list -R "$slug" --head "$branch" --state open --json milestone)
hit pitfall-filter-by-branch-name scripts/x.sh gh -R o/r pr list -H "$b" --jq '.[0].number'
miss pitfall-filter-by-branch-name tests/x.sh gh pr list --head "$b" --json number
miss pitfall-filter-by-branch-name hooks/x.sh gh pr list --head "$b" --json number,isCrossRepository
miss pitfall-filter-by-branch-name hooks/x.sh # gh pr list --head "$b"
miss pitfall-filter-by-branch-name hooks/x.sh echo "use gh pr list --head only with isCrossRepository"
miss pitfall-filter-by-branch-name hooks/x.sh gh pr list --author @me --json number,headRefName,isCrossRepository

# pitfall-escape-path-separator: tr maps / to a character other than a newline or a space; tr -d, a comment, a quoted
# mention, a test, and a newline or space target are not.
hit pitfall-escape-path-separator hooks/x.sh id=$(printf '%s' "$dir" | tr '/' '+')
hit pitfall-escape-path-separator scripts/x.sh tr -s / _ <<<"$path"
miss pitfall-escape-path-separator tests/x.sh tr '/' '_' <<<"$path"
miss pitfall-escape-path-separator hooks/x.sh tr -d '/' < "$f"
miss pitfall-escape-path-separator hooks/x.sh tr '/' '\n' <<<"$path"
miss pitfall-escape-path-separator hooks/x.sh # tr '/' '_'
miss pitfall-escape-path-separator hooks/x.sh echo "use tr '/' '_' only in tests"
miss pitfall-escape-path-separator hooks/x.sh tr '/' ' ' <<<"$path"

# pitfall-wait-all-checks: gh pr checks with --watch, which waits on every check; a whole-line comment, a quoted mention, a
# call that reads the checks with --json, and tests/ are not.
hit pitfall-wait-all-checks hooks/x.sh gh pr checks --watch
hit pitfall-wait-all-checks scripts/x.sh gh -R o/r pr checks 12 --watch --interval 30
miss pitfall-wait-all-checks tests/x.sh gh pr checks 12 --watch
miss pitfall-wait-all-checks hooks/x.sh # gh pr checks 12 --watch
miss pitfall-wait-all-checks hooks/x.sh gh pr checks 12 --json name,bucket
miss pitfall-wait-all-checks hooks/x.sh echo "waiting with gh pr checks --watch can hang"

# pitfall-config-by-grep: a grep on a line that names a git config file (gitconfig, .git/config, config.worktree); git
# config --get, a whole-line comment, a quoted mention, a path outside the globs, and tests/ are not.
hit pitfall-config-by-grep hooks/x.sh grep -q hooksPath ~/.gitconfig
hit pitfall-config-by-grep scripts/x.sh if grep -q '^\[core' "$r/.git/config"; then
hit pitfall-config-by-grep hooks/x.sh v=$(grep hooksPath "$HOME/.config/git/config")
miss pitfall-config-by-grep tests/x.sh grep -q hooksPath ~/.gitconfig
miss pitfall-config-by-grep hooks/x.sh # grep hooksPath ~/.gitconfig
miss pitfall-config-by-grep hooks/x.sh git config --get core.hooksPath
miss pitfall-config-by-grep hooks/x.sh echo "grep does not see include.path in ~/.gitconfig"
miss pitfall-config-by-grep docs/x.md grep -q hooksPath ~/.gitconfig
