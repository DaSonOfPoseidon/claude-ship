# claude-ship's own hygiene rules, read by hooks/lint.sh from the default branch (README.md › Hygiene lint). Only added
# lines are checked. The POSIX-only rule of AGENTS.md › Code Review Rules: the scripts run under /bin/sh on Linux and
# macOS, so no GNU-only flag. tests/ is exempt (its fixtures quote the flags on purpose), and so is a whole-line
# comment. In a ban's globs, a leading ! excludes a path: `*.sh,!tests/*` is every shell script but the tests.
# Each pattern walks the command's words up to the flag, so `sed -e p -i f` is a hit, while a word that is another
# option's argument (`grep -e -P f`, `grep -f -P f`, `grep --regexp -P f`) or follows `--` is not. A short option's
# argument is the rest of its word or the next word (`date -d2026-11-19`, `date -d 2026-11-19`). The walk knows each
# tool's own options (the letters and long names in the patterns): one it doesn't know ends the walk, so that line
# is not flagged. Approximate by design, like the comment rules.

ban gnu-sed-i error *.sh,!tests/* '(^|[^[:alnum:]_])sed([[:space:]]+(-[nrEsuzb]*|--[A-Za-z-]+=([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*|-[nrEsuzb]*[efl][[:space:]]+([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")+|-[nrEsuzb]*[efl]([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")+|--(quiet|silent|regexp-extended|separate|unbuffered|null-data|binary|posix|debug|sandbox|follow-symlinks|help|version)|--(expression|file|line-length)[[:space:]]+([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")+|([^[:space:]|;&()''"`-]|''[^'']*''|"[^"]*")([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*))*[[:space:]]+(-[nrEsuzb]*i|--in-place([^[:alnum:]_-]|$))' unless '^[[:space:]]*#' -- POSIX sed has no -i; write the output to a temp file and mv it over the original
ban gnu-date-d error *.sh,!tests/* '(^|[^[:alnum:]_])date([[:space:]]+(-[Ru]*|--[A-Za-z-]+=([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*|-[Ru]*[frs][[:space:]]+([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")+|-[Ru]*[frs]([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")+|-[Ru]*[I]([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*|--(utc|universal|rfc-2822|rfc-email|iso-8601|help|version|debug)|--(file|reference|set|rfc-3339)[[:space:]]+([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")+|([^[:space:]|;&()''"`-]|''[^'']*''|"[^"]*")([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*))*[[:space:]]+(-[Ru]*d|--date([^[:alnum:]_-]|$))' unless '^[[:space:]]*#' -- POSIX date has no -d; format the times with date -u +FORMAT and compare them as text, or use date +%s for epoch seconds
ban gnu-grep-p error *.sh,!tests/* '(^|[^[:alnum:]_])grep([[:space:]]+(-[EFGHILPRTUVZabchilnoqrsuvwxyz0-9]*|--[A-Za-z-]+=([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*|-[EFGHILPRTUVZabchilnoqrsuvwxyz0-9]*[ABCDXdefm][[:space:]]+([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")+|-[EFGHILPRTUVZabchilnoqrsuvwxyz0-9]*[ABCDXdefm]([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")+|--(extended-regexp|fixed-strings|basic-regexp|perl-regexp|ignore-case|no-ignore-case|word-regexp|line-regexp|invert-match|count|color|colour|files-with-matches|files-without-match|only-matching|quiet|silent|no-messages|byte-offset|with-filename|no-filename|line-number|initial-tab|null|null-data|text|recursive|dereference-recursive|binary|unix-byte-offsets|line-buffered|no-group-separator|help|version)|--(regexp|file|max-count|after-context|before-context|context|devices|directories|exclude|exclude-from|exclude-dir|include|label|binary-files|group-separator)[[:space:]]+([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")+|([^[:space:]|;&()''"`-]|''[^'']*''|"[^"]*")([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*))*[[:space:]]+(-[EFGHILPRTUVZabchilnoqrsuvwxyz0-9]*P|--perl-regexp([^[:alnum:]_-]|$))' unless '^[[:space:]]*#' -- POSIX grep has no -P; use grep -E (extended regular expressions) or awk for the pattern
ban gnu-readlink-f error *.sh,!tests/* '(^|[^[:alnum:]_])readlink([[:space:]]+(-[nqsvz]*|--[A-Za-z-]+=([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*|--(no-newline|quiet|silent|verbose|zero|help|version)|([^[:space:]|;&()''"`-]|''[^'']*''|"[^"]*")([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*))*[[:space:]]+(-[nqsvz]*[fem]|--canonicalize(-existing|-missing)?([^[:alnum:]_-]|$))' unless '^[[:space:]]*#' -- readlink -f is GNU-only; resolve a directory with (cd -P -- DIR && pwd -P)
ban gnu-stat-c error *.sh,!tests/* '(^|[^[:alnum:]_])stat([[:space:]]+(-[fLtZ]*|--[A-Za-z-]+=([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*|--(file-system|dereference|terse|help|version)|([^[:space:]|;&()''"`-]|''[^'']*''|"[^"]*")([^[:space:]|;&()''"`]|''[^'']*''|"[^"]*")*))*[[:space:]]+(-[fLtZ]*c|--(format|printf)([^[:alnum:]_-]|$))' unless '^[[:space:]]*#' -- stat -c is GNU-only and stat isn't POSIX; use wc -c < FILE for a size, or test -f and test -s for a check
# pitfall: Hooks judge a whole command before any of it runs. -> none: Describes the order of hook checks, not a line of code.
# pitfall: Pattern checks match text, not intent. -> none: Describes check design; no literal signature on one added line.
# pitfall: A command's name is not the program it runs, and a list of what is dangerous never ends. -> none: Describes trusting names over programs; no literal signature to ban.
# pitfall: A terminator written as a negation accepts characters you didn't think of. -> none: Regex design advice; a negated terminator has no single literal signature.
# pitfall: Process rules are a table, not a list of special cases. -> none: Describes how to state process rules, not code that breaks one.
# pitfall: A command interrupted midway may have done part of its work. -> none: Describes checking state after an interruption; no code signature.
# pitfall: GitHub's PR API lags a push. -> none: Describes read timing against GitHub; no single-line signature.
# pitfall: A wait loop that reads every failure as "not done yet" hides a broken command. -> none: Wait-loop error handling, which no single added line shows.
ban pitfall-pipeline-status warn *.sh,*.bash,!tests/* '^([^'']*''[^'']*'')*[^'']*[$][(][[:space:]]*gh[[:space:]]([^|"'')]|"[^"]*"|''[^'']*'')*[|]([^|]|$)' unless '^[[:space:]]*#' -- Assign the gh call to a variable on its own line and test its status; a pipeline reports only its last command's status, so a failed call reads as an empty result.
ban pitfall-missing-arg-exit warn *.sh,*.bash,!tests/* '(([-]z[[:space:]]+"?[$][{]?[1-9]|[$][#]"?[[:space:]]+-(eq|lt|le)[[:space:]]+[0-9])|[-]n[[:space:]]+"?[$][{]?[1-9][^|]*[|][|]).*exit[[:space:]]+1([^[:alnum:]_]|$)' unless '^[[:space:]]*#' -- A missing argument is misuse, not a result: exit 2 on it, so a caller can tell the two apart.
ban pitfall-status-stale warn .github/workflows/codex-*.yml 'cancel-in-progress:[[:space:]]*["'']?true([^[:alnum:]_]|$)' unless '^[[:space:]]*#' -- Keep one concurrency group per PR with cancel-in-progress: false, so the last run to start reads the latest state.
# pitfall: A pipeline's exit status is its last command's. -> pitfall-pipeline-status
# pitfall: Options and environment before a subcommand change what it does. -> none: Describes how checkers read command options; no single added line shows it.
# pitfall: Shell quoting and expansion hide the real argument from a text check. -> none: Describes checkers reading quoted words; no single added line shows it.
# pitfall: A missing argument under `set -u` exits 1, which a caller may read as a result. -> pitfall-missing-arg-exit
# pitfall: Checking one side of a pair leaves the other open. -> none: Describes checking both sides of a pair; no single line shows it.
# pitfall: A list of what's dangerous misses what nobody listed; list what's allowed. -> none: Describes allowlist design for checks; no single added line shows it.
# pitfall: A parser that returns nothing for input it doesn't recognize fails open. -> none: Describes parser failure modes; no single added line shows it.
# pitfall: A status computed from events goes stale when its inputs change some other way. -> pitfall-status-stale
# pitfall: A cached verdict outlives the inputs that produced it. -> none: Cache-key contents are design; the one git patch-id call is correct code.
# pitfall: A hook sees the whole command at once, but each step runs in the state of its own moment. -> none: Describes step ordering across a command; no single added line shows it.
# pitfall: A path is compared as text before it is resolved. -> none: Describes resolving paths before comparing; no literal signature on one line.
# pitfall: A permission that looks like it belongs to one step may serve others. -> none: Describes permissions shared by several API calls; no single line shows it.
# pitfall: Another tool's output can leave out a field you match on. -> none: Describes a blank output field's meaning; no single added line shows it.
# pitfall: Anyone can post a comment, and a completion doesn't say which request it answers. -> none: Describes trusted comment authors and request pairing; no single line shows it.
# pitfall: A completion marker can arrive before the content it announces. -> none: Describes waiting for content behind a marker; no single line shows it.
# pitfall: Local refs are state the agent controls. -> none: origin/main is used correctly across the tree; no narrow signature.
