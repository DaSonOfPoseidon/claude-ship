# claude-ship's own hygiene rules, read by hooks/lint.sh from the default branch (README.md › Hygiene lint). Only added
# lines are checked. The POSIX-only rule of AGENTS.md › Code Review Rules: the scripts run under /bin/sh on Linux and
# macOS, so no GNU-only flag. tests/ is exempt (its fixtures quote the flags on purpose), and so is a whole-line
# comment. In a ban's globs, a leading ! excludes a path: `*.sh,!tests/*` is every shell script but the tests.
# Each pattern skips the arguments before the flag (words and quoted strings), so `sed -e p -i f` is a hit too.

ban gnu-sed-i error *.sh,!tests/* '(^|[^[:alnum:]_])sed([[:space:]]+(-[A-Za-z-][^[:space:]|;&()''"`]*|[^[:space:]|;&()''"`-][^[:space:]|;&()''"`]*|''[^'']*''|"[^"]*"))*[[:space:]]+(-[A-Za-z]*i[A-Za-z]*|--in-place)([^[:alnum:]_-]|$)' unless '^[[:space:]]*#' -- POSIX sed has no -i; write the output to a temp file and mv it over the original
ban gnu-date-d error *.sh,!tests/* '(^|[^[:alnum:]_])date([[:space:]]+(-[A-Za-z-][^[:space:]|;&()''"`]*|[^[:space:]|;&()''"`-][^[:space:]|;&()''"`]*|''[^'']*''|"[^"]*"))*[[:space:]]+(-[A-Za-z]*d[A-Za-z]*|--date)([^[:alnum:]_-]|$)' unless '^[[:space:]]*#' -- POSIX date has no -d; format the times with date -u +FORMAT and compare them as text, or use date +%s for epoch seconds
ban gnu-grep-p error *.sh,!tests/* '(^|[^[:alnum:]_])grep([[:space:]]+(-[A-Za-z-][^[:space:]|;&()''"`]*|[^[:space:]|;&()''"`-][^[:space:]|;&()''"`]*|''[^'']*''|"[^"]*"))*[[:space:]]+(-[A-Za-z]*P[A-Za-z]*|--perl-regexp)([^[:alnum:]_-]|$)' unless '^[[:space:]]*#' -- POSIX grep has no -P; use grep -E (extended regular expressions) or awk for the pattern
ban gnu-readlink-f error *.sh,!tests/* '(^|[^[:alnum:]_])readlink([[:space:]]+(-[A-Za-z-][^[:space:]|;&()''"`]*|[^[:space:]|;&()''"`-][^[:space:]|;&()''"`]*|''[^'']*''|"[^"]*"))*[[:space:]]+(-[A-Za-z]*[fem][A-Za-z]*|--canonicalize)([^[:alnum:]_-]|$)' unless '^[[:space:]]*#' -- readlink -f is GNU-only; resolve a directory with (cd -P -- DIR && pwd -P)
ban gnu-stat-c error *.sh,!tests/* '(^|[^[:alnum:]_])stat([[:space:]]+(-[A-Za-z-][^[:space:]|;&()''"`]*|[^[:space:]|;&()''"`-][^[:space:]|;&()''"`]*|''[^'']*''|"[^"]*"))*[[:space:]]+(-[A-Za-z]*c[A-Za-z]*|--format|--printf)([^[:alnum:]_-]|$)' unless '^[[:space:]]*#' -- stat -c is GNU-only and stat isn't POSIX; use wc -c < FILE for a size, or test -f and test -s for a check
