# claude-ship hygiene lint: the built-in defaults, read by hooks/lint.sh. Deployed next to it and locked like the other
# hooks, so edit your own copy of a rule instead: ~/.claude/claude-ship/lint for this install, or
# .github/claude-ship/lint in a repository (read from its default branch, so a branch can't weaken its own lint).
# This file doubles as the reference for the grammar; README.md › Hygiene lint has the rest.
#
# Layers: this file, then the install's file, then the project's. A later layer wins, line by line.
# Only lines a diff adds are checked, so existing code never fails. One directive per line; `#` starts a comment only
# at the start of a line; blank lines are skipped. A malformed line is reported on stderr and skipped.
# Globs are shell patterns that match the repo-relative path; `*` spans `/`. They can't contain spaces (use `?`).
#
#   <rule|*> <off|warn|error> [glob | !glob ...]
#       Sets the level of a rule (`*` is every rule). The last line that applies to a path wins. No globs: every path.
#       A path that matches a !glob gets `off` from that line, so `debug-leftover error !scripts/*` is error everywhere
#       but under scripts/. Examples:
#           new-suppression off tests/*
#       and, in the install file, this turns the whole lint off (nothing may follow on the line):
#           * off
#
#   ban <id> <off|warn|error> <glob>[,<glob>...] [comment] '<ERE>' [unless '<ERE>'] -- <message>
#       A rule of your own: a line that matches the ERE (an extended regular expression, without \b: use
#       (^|[^[:alnum:]_])) is a hit, unless it also matches the `unless` ERE. The ban's level and globs also act as a
#       settings line for <id>, and several `ban` lines with one id are one rule with several patterns. With `comment`,
#       the EREs match the line's comment text only (the text after `#`, `//` or `--` for the file's extension, or
#       inside /* ... */); a line with no comment never matches. A single quote inside an ERE is written twice.
#       The message says what to do instead. Example:
#           ban no-print error *.py '(^|[^[:alnum:]_.])print\(' -- use the logging module, not print
#
#   skip <glob> ...
#       Paths that are never linted. Skip lines add up across the layers.
#
# Comment text by extension (approximate: a leader inside a string counts, and unknown extensions have no comments):
#   #   sh bash py rb pl r yaml yml toml conf, Makefile, Dockerfile
#   //  js jsx ts tsx mjs cjs go rs c h cc cpp hpp java kt swift cs scala dart php (and /* ... */ block lines)
#   --  sql lua hs
#
# Two rules are coded, not written as ban lines, so they only take a level here:
#   conflict-marker  merge-conflict markers at the start of a line (and a bare ======= when the file adds a <<<<<<< too)
#   invisible-char   zero-width, bidi-control and mid-file byte-order-mark characters
# `./lint.sh rules <path>` shows the effective level of every rule for a path and the file:line that set it.

conflict-marker error
invisible-char error

skip *.lock package-lock.json *.min.js *.min.css vendor/* node_modules/* *.svg

# --- the hygiene set: slips agents leave behind. Messages say what to do instead of the slip. ---
# POSIX ERE has no \b, so a word boundary is written (^|[^[:alnum:]_]) before and ([^[:alnum:]_]|$) after.

# debug-leftover: a debugger or breakpoint left in code. Lines that are only a comment don't count, and neither does a
# hit inside a quoted string: the `unless` also exempts a hit that follows an odd number of quotes ("..." and '...', plus
# `...` in js; not '...' in rs, where ' is a lifetime). Approximate: an escaped quote or mixed quoting on a line
# can miscount, and a line with a quoted mention and a real statement is exempt as well.
ban debug-leftover error *.js,*.jsx,*.ts,*.tsx,*.mjs,*.cjs '(^|[^[:alnum:]_$.])debugger[[:space:]]*([^[:alnum:]_$:"''[:space:]]|$)' unless '^[[:space:]]*(//|\*([[:space:]]|$)|\*/[[:space:]]*$|/\*([^*]|\*+[^*/])*(\**|\*+/[[:space:]]*)$)|^([^"]*"[^"]*")*[^"]*"[^"]*debugger|^([^'']*''[^'']*'')*[^'']*''[^'']*debugger|^([^`]*`[^`]*`)*[^`]*`[^`]*debugger' -- Remove the debugger statement; use a test or a log the code keeps.
ban debug-leftover error *.py '(^|[^[:alnum:]_.])breakpoint\(\)|(^|[^[:alnum:]_])i?pdb\.set_trace\(|(^|[^[:alnum:]_])import[[:space:]]+i?pdb([^[:alnum:]_]|$)' unless '^[[:space:]]*#|^([^"]*"[^"]*")*[^"]*"[^"]*(breakpoint\(\)|i?pdb\.set_trace\(|import[[:space:]]+i?pdb)|^([^'']*''[^'']*'')*[^'']*''[^'']*(breakpoint\(\)|i?pdb\.set_trace\(|import[[:space:]]+i?pdb)' -- Remove the debugger call; use a test or a log the code keeps.
ban debug-leftover error *.rb '(^|[^[:alnum:]_])binding\.(pry|irb)([^[:alnum:]_]|$)|(^|[^[:alnum:]_.])byebug([^[:alnum:]_]|$)' unless '^[[:space:]]*#|^([^"]*"[^"]*")*[^"]*"[^"]*(binding\.(pry|irb)|byebug)|^([^'']*''[^'']*'')*[^'']*''[^'']*(binding\.(pry|irb)|byebug)' -- Remove the debugger call; use a test or a log the code keeps.
ban debug-leftover error *.rs '(^|[^[:alnum:]_])dbg!\(' unless '^[[:space:]]*(//|\*([[:space:]]|$)|\*/[[:space:]]*$|/\*([^*]|\*+[^*/])*(\**|\*+/[[:space:]]*)$)|^([^"]*"[^"]*")*[^"]*"[^"]*dbg!\(' -- Remove the dbg! call; use a test or a log the code keeps.

# placeholder: a comment that stands in for code the agent didn't write.
ban placeholder error * comment '\.\.\.[[:space:]]*([Tt]he )?[Rr]est of (the )?code|[Rr]est of (the )?code[[:space:]]*\.\.\.' -- Write the code the placeholder stands for, or delete the comment; don't leave a stub for someone else to fill in.
ban placeholder error * comment '[Ee]xisting code (here|unchanged)' -- Write the code the placeholder stands for, or delete the comment; don't leave a stub for someone else to fill in.
ban placeholder error * comment '(^|[^[:alnum:]_])TODO:?[[:space:]]+[Ii]mplement|[Yy]our code here|YOUR CODE HERE|[Ii]mplementation goes here' -- Write the code the placeholder stands for, or delete the comment; don't leave a stub for someone else to fill in.

# narration: a comment that tells what changed (the diff and the commit say that) instead of what the code does.
ban narration warn * comment '^(Added|Changed|Updated|Modified|Removed|Fixed|Moved|Renamed|Replaced|Refactored)([^[:alnum:]_]|$)|^New:' -- Say what the code does, not what you changed (the diff and the commit message say that), or delete the comment.
ban narration warn * comment '([Aa]s requested|[Pp]er your request)([^[:alnum:]_]|$)' -- Say what the code does, not what you changed (the diff and the commit message say that), or delete the comment.

# new-suppression: a lint or type finding silenced instead of fixed. Docs that mention the markers are not code.
ban new-suppression warn * '(^|[^[:alnum:]_])noqa([^[:alnum:]_]|$)|eslint-disable|@ts-ignore|@ts-nocheck|@ts-expect-error|type:[[:space:]]*ignore|pyright:[[:space:]]*ignore|pragma: no cover' -- Fix the underlying lint finding instead of silencing it; if it's wrong, say why in the PR.
ban new-suppression warn * 'shellcheck[[:space:]]+disable|(^|[^[:alnum:]_])nolint([^[:alnum:]_]|$)|rubocop:[[:space:]]*disable|#!?\[allow\(|@SuppressWarnings|NOSONAR|istanbul ignore' -- Fix the underlying lint finding instead of silencing it; if it's wrong, say why in the PR.
new-suppression off *.md *.mdx *.txt *.rst *.adoc

# skipped-test: a test left skipped or focused, including the parameterized form (it.only.each(...), test.skip.each`...`).
# Conditional skips (skipIf, skipUnless) are deliberate and not flagged.
ban skipped-test warn *.js,*.jsx,*.ts,*.tsx,*.mjs,*.cjs '\.(skip|only)(\.each)?[(`]|(^|[^[:alnum:]_$.])(xit|xdescribe|fit|fdescribe)\(' -- Make the test pass or delete it; a skipped test checks nothing and a focused one silently skips the rest.
ban skipped-test warn *.py '@pytest\.mark\.skip([^[:alnum:]_]|$)|@unittest\.skip([^[:alnum:]_]|$)' -- Make the test pass or delete it; a skipped test checks nothing.
ban skipped-test warn *.go '(^|[^[:alnum:]_])t\.Skip(f|Now)?\(' -- Make the test pass or delete it; a skipped test checks nothing.
ban skipped-test warn *.rs '#\[ignore(\]|[[:space:]]*=)' -- Make the test pass or delete it; an ignored test checks nothing.
ban skipped-test warn *.java,*.kt '@Disabled([^[:alnum:]_]|$)' -- Make the test pass or delete it; a disabled test checks nothing.

# todo-no-issue: work promised with no issue to track it. TODO(#12), TODO(PROJ-12) and a link are fine.
ban todo-no-issue warn * comment '(^|[^[:alnum:]_])(TODO|FIXME|XXX|HACK)([^[:alnum:]_]|$)' unless '#[0-9]+|(^|[^[:alnum:]_])[A-Z][A-Z0-9]+-[0-9]+|https?://' -- Link the work to an issue (TODO(#123) or a URL), or do it now.

# new-comment: off by default. Turn it on (new-comment warn) to flag every added comment except a shebang. A shebang is
# only a comment in the # languages, so only those exempt text that starts with ! (a Rust //! doc comment is a comment).
ban new-comment off *.sh,*.bash,*.py,*.rb,*.pl,*.r,*.R,*.yaml,*.yml,*.toml,*.conf,*Makefile,*makefile,*Dockerfile comment '.*' unless '^!' -- Remove the comment and make the code say it (a name, a smaller function, a test).
ban new-comment off *.js,*.jsx,*.ts,*.tsx,*.mjs,*.cjs,*.go,*.rs,*.c,*.h,*.cc,*.cpp,*.hpp,*.java,*.kt,*.swift,*.cs,*.scala,*.dart,*.php,*.sql,*.lua,*.hs comment '.*' -- Remove the comment and make the code say it (a name, a smaller function, a test).
